# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/estoque?schema=public"

# ---- Better-Auth ----
BETTER_AUTH_SECRET="dev-secret-change-me-please-32chars-min"
BETTER_AUTH_URL="http://localhost:3000"

# ---- Microsoft Entra ID (login com Microsoft) ----
# Crie um app no Portal Azure (Microsoft Entra ID), registre a URI de redirecionamento:
# http://localhost:3000/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# ---- Perfil OWNER (Secretaria de TI - controla o sistema) ----
# Definidos EXCLUSIVAMENTE aqui - não pela interface, pelo registro público
# nem por um administrador.

# 1) Lista (separada por vírgula) de e-mails com perfil OWNER (acesso pleno).
OWNERS="ti@sms.gov"

# 2) Conta principal da TI: e-mail + senha definidos no .env.
#    O login com este e-mail cria o usuário automaticamente no primeiro acesso
#    (perfil OWNER). Se o usuário já existir, a senha do .env NÃO sobrescreve:
#    o login passa a valer pela senha real cadastrada.
OWNER_EMAIL="ti@sms.gov"
OWNER_SENHA=""

# ---- Mailer (SMTP por organização/secretaria) ----
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@sms.com"
SMTP_PASS="smtp-pass"
SMTP_FROM="Sistema de Estoque <noreply@sms.com>"
